# --- Core ---------------------------------------------------------------------

DATABASE_URL=postgres://user:password@host:5432/freewhen?sslmode=require
PORT=8080

# Log level: debug | info | warn | error (optional, default: info)
LOG_LEVEL=info

# --- CORS & cookies -----------------------------------------------------------

CORS_ORIGIN=http://localhost:3000

# Set SECURE_COOKIES=false for local HTTP dev. Defaults to true (fail-safe for prod).
# When SECURE_COOKIES=true, COOKIE_DOMAIN is required.
SECURE_COOKIES=true

# Cookie domain — required when SECURE_COOKIES=true. Leave empty for localhost HTTP dev.
COOKIE_DOMAIN=

# --- Frontend link ------------------------------------------------------------

# Used to build links in outbound emails. Required unless AUTH_EMAIL_DISABLED=true.
FRONTEND_URL=http://localhost:3000

# --- Auth: magic-link email ---------------------------------------------------

# RESEND_API_KEY + MAGIC_LINK_FROM_EMAIL + FRONTEND_URL are required together.
# For dev on unrelated features, set AUTH_EMAIL_DISABLED=true and leave the
# three values below unset.
AUTH_EMAIL_DISABLED=false
RESEND_API_KEY=
MAGIC_LINK_FROM_EMAIL=onboarding@resend.dev

# --- Auth: Google OAuth -------------------------------------------------------

# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET must be set together, or both left
# unset to disable. At least one redirect URL is required when credentials are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback
GOOGLE_CALENDAR_REDIRECT_URL=http://localhost:8080/auth/google/calendar/callback

# --- Calendar access tokens ---------------------------------------------------

# Secret for signing password-protected calendar access tokens (≥32 bytes).
# Generate with: openssl rand -base64 48
CALENDAR_ACCESS_SECRET=

# --- Analytics & feature flags (PostHog) --------------------------------------

# All optional — when POSTHOG_KEY is unset, flag evaluation no-ops and returns
# the caller-supplied fallback. POSTHOG_PERSONAL_API_KEY enables in-process
# flag polling (faster, fewer remote evals).
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_PERSONAL_API_KEY=
