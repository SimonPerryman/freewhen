DATABASE_URL=postgres://user:password@host:5432/freewhen?sslmode=require
PORT=8080
CORS_ORIGIN=http://localhost:3000

# Log level: debug | info | warn | error (default: info)
# LOG_LEVEL=info

# Set SECURE_COOKIES=false for local HTTP dev. Defaults to true (fail-safe for prod).
# SECURE_COOKIES=false

# Secret for signing password-protected calendar access tokens (≥32 bytes). Generate with: openssl rand -base64 48
CALENDAR_ACCESS_SECRET=

# Auth (required for Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback
FRONTEND_URL=http://localhost:3000

# Cookie domain (leave empty for localhost)
COOKIE_DOMAIN=

# Magic link email (optional — only needed for email sign-in, Google OAuth works without)
RESEND_API_KEY=
MAGIC_LINK_FROM_EMAIL=onboarding@resend.dev
